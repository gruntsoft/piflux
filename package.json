  "type": "module",
  "description": "A human-in-the-loop coding workflow for Pi Coding Agent: plan, implement, review, and ship across focused agent sessions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gruntsoft/piflux.git"
  },
  "homepage": "https://github.com/gruntsoft/piflux#readme",
