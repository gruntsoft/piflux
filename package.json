    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\""
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/gruntsoft/piflux/main/docs/basic-workflow.png"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
